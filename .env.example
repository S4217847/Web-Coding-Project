# Copy this file to .env and replace the placeholders with private values.
MONGODB_URI=mongodb+srv://APP_USER:APP_PASSWORD@CLUSTER_HOST/?retryWrites=true&w=majority

# The MongoDB database used by RMIT Connect.
MONGODB_DB_NAME=rmit_connect

# Replace this with a long unpredictable value in a real deployment.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Never expose reset links publicly.
SHOW_DEMO_RESET_LINK=false

# Hosting providers normally supply PORT automatically.
PORT=3000