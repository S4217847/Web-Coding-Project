# Required: use the dedicated application database user from the team Atlas project.
MONGODB_URI=mongodb+srv://APP_USER:APP_PASSWORD@CLUSTER_HOST/?retryWrites=true&w=majority

# Keep assessment, development, and test records in clearly named databases.
MONGODB_DB_NAME=rmit_connect

# Generate a long random value; never reuse the example text in production.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Local classroom demonstrations may expose a reset link on screen. Leave this
# false in a public deployment and deliver the link through a private channel.
SHOW_DEMO_RESET_LINK=false

# Hosting providers normally set PORT automatically.
PORT=3000
