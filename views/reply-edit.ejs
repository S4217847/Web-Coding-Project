<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %> | RMIT Connect</title>
    <link rel="stylesheet" href="/css/common.css" />
    <link rel="stylesheet" href="/css/discussion.css" />
  </head>
  <body>
    <header>
      <div class="logo">RMIT CONNECT</div>
      <input
        class="searchbar"
        type="text"
        placeholder="Search RMIT Connect..."
      />
      <nav>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/discussions">Discussions</a></li>
          <li><a href="/blogs">My Blog</a></li>
          <li><a href="/profile/profile.html">My Profile</a></li>
        </ul>
      </nav>
    </header>

    <main class="page">
      <div class="leftbar">
        <div class="menu-card">
          <ul>
            <li><a href="#">My Feed</a></li>
            <li><a href="#">My Clubs</a></li>
            <li><a href="#">Saved Posts</a></li>
            <li><a href="/wishlist">Favourites</a></li>
            <li><a href="#">Settings</a></li>
          </ul>
        </div>
      </div>

      <div class="middle">
        <!-- Show the current reply values so the author can change them. -->
        <form
          id="edit-form"
          class="postbox"
          method="post"
          action="/discussions/<%= discussion._id %>/replies/<%= reply._id %>/edit"
        >
          <h1>Edit reply</h1>

          <label for="edit-title">Reply title</label>
          <input
            id="edit-title"
            name="replyTitle"
            type="text"
            value="<%= reply.title %>"
            maxlength="100"
            required
          />

          <div class="error" id="edit-title-error-text"></div>

          <label for="edit-image">Reply image</label>
          <select id="edit-image" name="replyImage" required>
            <option
              value="/images/peer-workshop.jpg"
              <%= reply.image === "/images/peer-workshop.jpg" ? "selected" : "" %>
            >
              Peer Workshop
            </option>
            <option
              value="/images/RMIT_campus.png"
              <%= reply.image === "/images/RMIT_campus.png" ? "selected" : "" %>
            >
              RMIT Campus
            </option>
            <option
              value="/images/saigonview.jpg"
              <%= reply.image === "/images/saigonview.jpg" ? "selected" : "" %>
            >
              Saigon View
            </option>
          </select>

          <div class="error" id="edit-image-error-text"></div>

          <label for="edit-content">Reply content</label>
          <textarea
            id="edit-content"
            name="replyContent"
            maxlength="1000"
            required
          ><%= reply.content %></textarea>

          <div class="error" id="edit-content-error-text"></div>

          <div class="postfooter">
            <a href="/discussions/<%= discussion._id %>">Cancel</a>
            <button class="postbtn" type="submit">Save changes</button>
          </div>
        </form>
      </div>

      <div class="rightbar">
        <div class="itembar">
          <div class="itemtitle">Upcoming Events</div>
          <div class="eventitem">
            <span class="eventdate">Jul #</span> - Coding Contest
          </div>
          <div class="eventitem">
            <span class="eventdate">Jul #</span> - Something Contest
          </div>
          <div class="eventitem">
            <span class="eventdate">Jul #</span> - Contest Contest
          </div>
        </div>

        <div class="itembar">
          <div class="itemtitle">Friends Online</div>
          <div class="frienditem">
            <div class="friendavatar"></div>
            <div class="friendname">Kim</div>
          </div>
          <div class="frienditem">
            <div class="friendavatar"></div>
            <div class="friendname">Dat</div>
          </div>
          <div class="frienditem">
            <div class="friendavatar"></div>
            <div class="friendname">Hoang</div>
          </div>
        </div>
      </div>
    </main>
    <script src="/js/edit-form.js"></script>
  </body>
</html>
