<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %> | RMIT Connect</title>
    <link rel="stylesheet" href="/css/common.css" />
    <link rel="stylesheet" href="/css/discussion.css" />
    <link rel="stylesheet" href="/css/navigation.css" />
  </head>
  <body id="top">
    <%- include("partials/global-navigation", {
      activePage: "discussions",
      sessionAction: "logout"
    }) %>

    <main id="main-content" class="page">
      <div class="leftbar">
        <nav class="menu-card" aria-label="Explore RMIT Connect">
          <ul>
            <li><a href="/discussions" aria-current="page">Discussion Forum</a></li>
            <li><a href="/blogs">Blogs</a></li>
            <li><a href="/reviews/browse">Reviews</a></li>
            <li><a href="/wishlist">Favorites</a></li>
            <li><a href="/editprofile.html">Profile settings</a></li>
          </ul>
        </nav>
      </div>

      <div class="middle">
        <div class="discussion-heading">
          <div>
            <% if (selectedProduct) { %>
              <a class="back-link" href="/discussions">View all discussions</a>
              <h1>Questions about <%= selectedProduct.name %></h1>
              <p class="discussion-context-category">Category: <%= selectedProduct.category %></p>
            <% } else { %>
              <h1>Discussion Forum</h1>
            <% } %>
          </div>

          <button
            id="show-post-form-button"
            class="show-post-form-button"
            type="button"
            aria-controls="post-form"
            aria-expanded="false"
            data-open-post-form
            <% if (selectedProduct) { %>
              data-context-product-slug="<%= selectedProduct.slug %>"
            <% } %>
          >
            <img src="/images/icons/plus.png" alt="" />
            <span><%= selectedProduct ? "Ask about this item" : "Start a discussion" %></span>
          </button>
        </div>

        <% if (productFilterMessage) { %>
          <p class="discussion-filter-message"><%= productFilterMessage %></p>
        <% } %>

        <section
          class="product-question-browser"
          aria-labelledby="browse-product-heading"
        >
          <h2 id="browse-product-heading">
            Find questions about a course or activity
          </h2>
          <p>Find an item to see questions linked to it.</p>

          <label for="browse-product-search">Search courses or activities</label>
          <input
            id="browse-product-search"
            type="search"
            maxlength="120"
            placeholder="Search courses or activities"
            autocomplete="off"
          />

          <p id="browse-product-result-message" class="product-result-message" aria-live="polite">
            Type at least 2 letters to find a course or activity.
          </p>

          <ul id="browse-product-results" class="product-search-results">
            <% for (let i = 0; i < products.length; i += 1) { %>
              <li data-product-name="<%= products[i].name.toLowerCase() %>" hidden>
                <a href="/discussions?product=<%= products[i].slug %>">
                  <span><%= products[i].name %></span>
                  <span class="product-result-category">Category: <%= products[i].category %></span>
                </a>
              </li>
            <% } %>
          </ul>
        </section>

        <form
          id="post-form"
          class="postbox postbox-hidden"
          data-user-id="<%= currentUserId %>"
          data-clear-draft="<%= clearDiscussionDraft %>"
          data-context-product-slug="<%= selectedProduct ? selectedProduct.slug : "" %>"
          data-context-product-name="<%= selectedProduct ? selectedProduct.name : "" %>"
          method="post"
          action="/discussions"
          enctype="multipart/form-data"
        >
          <label for="post-title">Post title</label>

          <input
            id="post-title"
            name="postTitle"
            type="text"
            placeholder="Enter a discussion title"
            maxlength="100"
            required
          />

          <div class="error" id="title-error-text"></div>

          <label for="post-image">Post image</label>

          <input
            type="file"
            id="post-image"
            name="postImage"
            accept="image/jpeg, image/png"
            required
          />

          <div class="error" id="image-error-text"></div>

          <label for="post-content">Post content</label>

          <textarea
            id="post-content"
            name="postContent"
            placeholder="Start a discussion with RMIT Connect..."
            maxlength="1000"
            required
          ></textarea>

          <div class="error" id="content-error-text"></div>

          <section class="discussion-product-picker" aria-labelledby="post-product-heading">
            <h2 id="post-product-heading">What is your question about? (optional)</h2>
            <p>You can connect your question to a course or activity.</p>

            <input id="product-slug" name="productSlug" type="hidden" value="" />

            <div class="selected-product-row">
              <p id="selected-product-text">
                No course or activity selected. You can still post.
              </p>
              <div class="product-selection-actions">
                <button
                  id="choose-post-product"
                  type="button"
                  class="text-button"
                  aria-controls="post-product-search-panel"
                  aria-expanded="false"
                >
                  Choose a course or activity
                </button>
                <button
                  id="change-post-product"
                  type="button"
                  class="text-button"
                  aria-controls="post-product-search-panel"
                  aria-expanded="false"
                  hidden
                >
                  Change selection
                </button>
                <button id="clear-post-product" type="button" class="text-button" hidden>
                  Remove selection
                </button>
              </div>
            </div>

            <div id="post-product-search-panel" class="product-search-panel" hidden>
              <label for="post-product-search">Search courses or activities</label>
              <input
                id="post-product-search"
                type="search"
                maxlength="120"
                placeholder="Search courses or activities"
                autocomplete="off"
              />

              <p id="post-product-result-message" class="product-result-message" aria-live="polite">
                Type at least 2 letters to find a course or activity.
              </p>

              <ul id="post-product-results" class="product-search-results">
                <% for (let i = 0; i < products.length; i += 1) { %>
                  <li data-product-name="<%= products[i].name.toLowerCase() %>" hidden>
                    <button
                      type="button"
                      data-product-slug="<%= products[i].slug %>"
                      data-product-display-name="<%= products[i].name %>"
                    >
                      <span><%= products[i].name %></span>
                      <span class="product-result-category">Category: <%= products[i].category %></span>
                    </button>
                  </li>
                <% } %>
              </ul>

              <button id="cancel-post-product-search" type="button" class="text-button product-search-cancel">
                Cancel
              </button>
            </div>

            <div id="product-draft-choice" class="product-draft-choice" hidden>
              <p>Your saved discussion draft uses a different related item setting.</p>
              <div class="product-draft-actions">
                <button id="keep-draft-product" type="button" class="text-button">
                  Keep saved draft setting
                </button>
                <button id="use-context-product" type="button" class="postbtn"></button>
              </div>
            </div>
          </section>

          <section class="discussion-review-picker" aria-labelledby="post-review-heading">
            <h2 id="post-review-heading">Related review (optional)</h2>
            <p>Connect one existing review when your post is a follow-up question.</p>

            <input id="review-id" name="reviewId" type="hidden" value="" />

            <div class="selected-product-row">
              <p id="selected-review-text">
                No review selected. You can still post.
              </p>
              <div class="product-selection-actions">
                <button
                  id="choose-post-review"
                  type="button"
                  class="text-button"
                  aria-controls="post-review-search-panel"
                  aria-expanded="false"
                >
                  Choose a review
                </button>
                <button
                  id="change-post-review"
                  type="button"
                  class="text-button"
                  aria-controls="post-review-search-panel"
                  aria-expanded="false"
                  hidden
                >
                  Change selection
                </button>
                <button id="clear-post-review" type="button" class="text-button" hidden>
                  Remove selection
                </button>
              </div>
            </div>

            <div id="post-review-search-panel" class="product-search-panel" hidden>
              <label for="post-review-search">Search by course code or review title</label>
              <input
                id="post-review-search"
                type="search"
                maxlength="120"
                placeholder="Search course code or review title"
                autocomplete="off"
              />

              <p id="post-review-result-message" class="product-result-message" aria-live="polite">
                Type at least 2 letters to find a review.
              </p>

              <ul id="post-review-results" class="product-search-results">
                <% for (let i = 0; i < reviews.length; i += 1) { %>
                  <li
                    data-review-search="<%= (reviews[i].courseCode + " " + reviews[i].title).toLowerCase() %>"
                    hidden
                  >
                    <button
                      type="button"
                      data-review-id="<%= reviews[i]._id %>"
                      data-review-course-code="<%= reviews[i].courseCode %>"
                      data-review-title="<%= reviews[i].title %>"
                    >
                      <span><%= reviews[i].courseCode %> · <%= reviews[i].title %></span>
                      <span class="product-result-category">Review #<%= reviews[i].id %></span>
                    </button>
                  </li>
                <% } %>
              </ul>

              <button id="cancel-post-review-search" type="button" class="text-button product-search-cancel">
                Cancel
              </button>
            </div>
          </section>

          <div class="postfooter">
            <button class="postbtn" type="submit">Post</button>
          </div>
        </form>

        <section class="discussion-list">
          <% if (discussionMessage) { %>
            <p class="discussion-delete-message"><%= discussionMessage %></p>
          <% } %>

          <% if (discussions.length > 0) { %>
            <form
              id="discussion-filter-form"
              class="discussion-filter"
              method="get"
              action="/discussions"
            >
            <div class="discussion-search">
              <label for="search-discussion">Search discussions</label>

              <input
                id="search-discussion"
                name="search"
                type="text"
                placeholder="Enter the keyword"
              />
            </div>

            <div class="discussion-option">
              <label for="filterby">Filter by</label>

              <select id="filterby" name="filterby">
                <option value="title">Title</option>
                <option value="content">Content</option>
              </select>
            </div>

            <div class="discussion-option">
              <label for="sortby">Sort by</label>

              <select id="sortby" name="sortby">
                <option value="newest">Newest</option>
                <option value="oldest">Oldest</option>
              </select>
            </div>

            <button class="searchbutton" type="submit">Search</button>
            </form>

            <p class="no-discussions" id="no-discussions" hidden>
              No discussions match your search.
            </p>
          <% } else if (selectedProduct) { %>
            <div class="product-empty-state">
              <h2>No questions about <%= selectedProduct.name %> yet</h2>
              <p>Be the first student to ask a question about this item.</p>
              <button
                class="postbtn"
                type="button"
                data-open-post-form
                data-context-product-slug="<%= selectedProduct.slug %>"
              >
                Ask the first question
              </button>
              <a href="/discussions">View all discussions</a>
            </div>
          <% } else { %>
            <div class="product-empty-state">
              <h2>No discussions yet</h2>
              <p>Start the first discussion for the RMIT Connect community.</p>
              <button class="postbtn" type="button" data-open-post-form>
                Start the first discussion
              </button>
            </div>
          <% } %>

          <div id="discussion-post-list" class="discussion-post-list">
            <% discussions.forEach(function(discussion, i) { %>
              <article
                class="discussion-post"
                data-title-search="<%= titleSearchTexts[i] %>"
                data-content-search="<%= contentSearchTexts[i] %>"
                data-created-at="<%= discussion.createdAt.getTime() %>"
                data-latest-activity="<%= latestActivityTimes[i] %>"
              >
              <div class="discussion-post-header">
                <div class="user-info">
                  <img
                    class="user-avatar"
                    src="<%= authors[i].profileImage %>"
                    alt="Profile image of <%= authors[i].username %>"
                  />
                  <div>
                    <p class="post-author"><%= authors[i].username %></p>
                    <p class="post-course"><%= authors[i].course %></p>
                  </div>
                </div>

                <p class="post-time"><%= discussion.createdAt %></p>
              </div>

              <% if (relatedProducts[i]) { %>
                <a
                  class="discussion-product-badge"
                  href="/discussions?product=<%= relatedProducts[i].slug %>"
                >
                  <%= relatedProducts[i].name %>
                </a>
              <% } else if (discussion.productId) { %>
                <span class="discussion-product-badge discussion-product-unavailable">
                  Related item unavailable
                </span>
              <% } else { %>
                <span class="discussion-product-badge discussion-product-general">
                  General discussion
                </span>
              <% } %>

              <h2><%= discussion.title %></h2>

              <img
                class="post-image"
                src="<%= discussion.image %>"
                alt="<%= discussion.title %>"
              />

              <p class="post-content"><%= discussion.content %></p>

              <div class="discussion-post-footer">
                <span><%= replyCounts[i] %> replies</span>
                <a href="/discussions/<%= discussion._id %>">View discussion</a>
              </div>
              </article>
            <% }); %>
          </div>
        </section>
      </div>

      <div class="rightbar">
        <div class="itembar">
          <div class="itemtitle">Upcoming Events</div>
          <div class="eventitem">
            <span class="eventdate">Jul #</span> - Coding Contest
          </div>
          <div class="eventitem">
            <span class="eventdate">Jul #</span> - Something Contest
          </div>
          <div class="eventitem">
            <span class="eventdate">Jul #</span> - Contest Contest
          </div>
        </div>

        <div class="itembar">
          <div class="itemtitle">Friends Online</div>
          <div class="frienditem">
            <div class="friendavatar"></div>
            <div class="friendname">Kim</div>
          </div>
          <div class="frienditem">
            <div class="friendavatar"></div>
            <div class="friendname">Dat</div>
          </div>
          <div class="frienditem">
            <div class="friendavatar"></div>
            <div class="friendname">Jay Nguyen</div>
          </div>
        </div>
      </div>
    </main>
    <script src="/js/discussion.js"></script>
  </body>
</html>
