<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %> | RMIT Connect</title>
    <link rel="stylesheet" href="/css/sitemap.css" />
  </head>

  <body>
    <header>
      <div class="logo">RMIT CONNECT</div>
      <input
        class="searchBar"
        type="text"
        placeholder="Search RMIT Connect..."
      />
      <nav>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/sitemap">Sitemap</a></li>
          <li><a href="/discussions">Discussions</a></li>
          <li><a href="/blogs">My Blog</a></li>
          <li><a href="/editprofile.html">My Profile</a></li>
        </ul>
      </nav>
    </header>

    <section class="pageBanner">
      <div class="pageBannerInner">
        <h1 class="pageTitle">RMIT Connect</h1>
        <p class="pageSubtitle">
          A full overview of the current pages and features on RMIT Connect.
        </p>
      </div>
    </section>

    <main class="siteMapWrapper">
      <section class="mapSection">
        <h2 class="mapSectionTitle">Main Navigation</h2>

        <div class="groupRow">
          <div class="groupCell">
            <div class="linkList">
              <a href="/">Home</a>
              <a href="/login.html">Login</a>
              <a href="/editprofile.html">Edit Profile</a>
            </div>
          </div>

          <div class="groupCell">
            <div class="linkList">
              <a href="/discussions">Discussion Forum</a>
              <a href="/blogs">Blog</a>
              <a href="/reviews/browse">Reviews</a>
            </div>
          </div>

          <div class="groupCell">
            <div class="linkList">
              <a href="/wishlist">Wishlist and Favourites</a>
              <a href="/wishlist/add">Browse Items</a>
            </div>
          </div>
        </div>
      </section>

      <section class="mapSection">
        <h2 class="mapSectionTitle">Account Actions</h2>

        <div class="groupRow">
          <div class="groupCell">
            <h3 class="groupHeading">Password</h3>
            <div class="linkList">
              <a href="/forgot-password">Forgot Password</a>
            </div>
          </div>

          <div class="groupCell">
            <h3 class="groupHeading">Account</h3>
            <div class="linkList">
              <a href="/editprofile.html">Edit Profile</a>
              <a href="/deactivate-account">Deactivate Account</a>
            </div>
          </div>

          <div class="groupCell">
            <h3 class="groupHeading">Session</h3>
            <div class="linkList">
              <a href="/logout">Log out</a>
            </div>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
