<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %> | RMIT Connect</title>
    <link rel="stylesheet" href="/css/common.css" />
    <link rel="stylesheet" href="/css/discussion.css" />
    <link rel="stylesheet" href="/css/navigation.css" />
  </head>
  <body id="top">
    <%- include("partials/global-navigation", {
      activePage: "discussions",
      sessionAction: "logout"
    }) %>

    <main id="main-content" class="page">
      <div class="leftbar">
        <nav class="menu-card" aria-label="Explore RMIT Connect">
          <ul>
            <li><a href="/discussions" aria-current="page">Discussion Forum</a></li>
            <li><a href="/blogs">Blogs</a></li>
            <li><a href="/reviews/browse">Reviews</a></li>
            <li><a href="/wishlist">Favorites</a></li>
            <li><a href="/editprofile.html">Profile settings</a></li>
          </ul>
        </nav>
      </div>

      <div class="middle">
        <form
          id="edit-form"
          class="postbox"
          method="post"
          action="/discussions/<%= discussion._id %>/edit"
          enctype="multipart/form-data"
        >
          <h1>Edit discussion</h1>

          <label for="edit-title">Post title</label>
          <input
            id="edit-title"
            name="postTitle"
            type="text"
            value="<%= discussion.title %>"
            maxlength="100"
            required
          />

          <div class="error" id="edit-title-error-text"></div>

          <label for="edit-image">New post image</label>
          <input
            type="file"
            id="edit-image"
            name="postImage"
            accept="image/jpeg, image/png"
          />

          <p>Leave this empty to keep the current image</p>

          <div class="error" id="edit-image-error-text"></div>

          <label for="edit-content">Post content</label>
          <textarea
            id="edit-content"
            name="postContent"
            maxlength="1000"
            required
          ><%= discussion.content %></textarea>

          <div class="error" id="edit-content-error-text"></div>

          <div class="postfooter">
            <a href="/discussions/<%= discussion._id %>">Cancel</a>
            <button class="postbtn" type="submit">Save changes</button>
          </div>
        </form>
      </div>

      <div class="rightbar">
        <div class="itembar">
          <div class="itemtitle">Upcoming Events</div>
          <div class="eventitem">
            <span class="eventdate">Jul #</span> - Coding Contest
          </div>
          <div class="eventitem">
            <span class="eventdate">Jul #</span> - Something Contest
          </div>
          <div class="eventitem">
            <span class="eventdate">Jul #</span> - Contest Contest
          </div>
        </div>

        <div class="itembar">
          <div class="itemtitle">Friends Online</div>
          <div class="frienditem">
            <div class="friendavatar"></div>
            <div class="friendname">Kim</div>
          </div>
          <div class="frienditem">
            <div class="friendavatar"></div>
            <div class="friendname">Dat</div>
          </div>
          <div class="frienditem">
            <div class="friendavatar"></div>
            <div class="friendname">Jay Nguyen</div>
          </div>
        </div>
      </div>
    </main>
    <script src="/js/edit-form.js"></script>
  </body>
</html>
