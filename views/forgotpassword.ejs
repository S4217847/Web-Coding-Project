<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password | RMIT Connect</title>
    <link rel="stylesheet" href="/css/common.css" />
    <link rel="stylesheet" href="/css/password.css" />
    <link rel="stylesheet" href="/css/navigation.css" />
  </head>

  <body id="top">
    <%- include("partials/global-navigation", {
      activePage: "account",
      sessionAction: "login"
    }) %>

    <main id="main-content" class="forgot-password-page">
      <div class="forgot-password-card">
        <h1>Forgot Password?</h1>

        <p class="forgot-password-text">
          Enter the email address currently saved in your Profile and the
          recovery password you set earlier. No reset email is sent.
        </p>

        <% if (resetMessage) { %>
          <p class="reset-message"><%= resetMessage %></p>
        <% } %>

        <% if (formError) { %>
          <p class="error"><%= formError %></p>
        <% } %>

        <form
          id="forgot-password-form"
          class="forgot-password-form"
          action="/forgot-password"
          method="post"
        >
          <label for="reset-email">Email Address</label>

          <input
            id="reset-email"
            type="email"
            placeholder="example@email.com"
            maxlength="120"
            name="reset-email"
            value="<%= emailValue %>"
            required
          />

          <div class="error" id="email-error-text"><%= emailError %></div>

          <label for="recovery-password">Recovery Password</label>

          <input
            id="recovery-password"
            type="password"
            name="recovery-password"
            minlength="12"
            maxlength="64"
            autocomplete="off"
            required
          />

          <div class="error" id="recovery-password-error-text">
            <%= recoveryPasswordError %>
          </div>

          <button class="resetbutton" type="submit">Continue to Reset</button>
        </form>

        <p class="reset-message">
          Use 12–64 ASCII characters without spaces, including uppercase and
          lowercase letters and a number. If you never set a recovery password
          or also forgot it, this demo cannot reset your password. There is no
          identity-check bypass. For privacy, errors do not confirm whether an
          account exists.
        </p>

        <p class="account-help">
          Remember your password?
          <a href="/login.html" class="common-link">Log in</a>
        </p>
      </div>
    </main>
    <script src="/js/forgotpassword.js"></script>
  </body>
</html>
