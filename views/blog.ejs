<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blogs | RMIT Connect</title>
    <link rel="stylesheet" href="/css/navigation.css" />
    <link rel="stylesheet" href="/css/blog.css" />
  </head>

  <body>
    <%- include("partials/global-navigation", {
      activePage: "blogs",
      sessionAction: "logout"
    }) %>

    <main class="page" id="main-content">
      <aside class="leftbar" aria-label="Explore RMIT Connect">
        <nav class="menu-card" aria-label="Explore">
          <ul>
            <li><a href="/blogs" aria-current="page">All blogs</a></li>
            <li><a href="/discussions">Discussions</a></li>
            <li><a href="/reviews/browse">Reviews</a></li>
            <li><a href="/wishlist">Wishlist</a></li>
            <li><a href="/sitemap">Sitemap</a></li>
          </ul>
        </nav>
      </aside>

      <section class="middle" aria-labelledby="recent-blogs-title">
        <form
          id="blog-search-form"
          class="searchbar"
          action="/blogs"
          method="get"
          role="search"
        >
          <label class="text-label" for="blog-search">Search blogs</label>
          <input
            id="blog-search"
            class="search-input"
            name="q"
            type="search"
            placeholder="Search blogs..."
          />
          <label class="text-label" for="search-category">Search field</label>
          <select
            id="search-category"
            class="search-categories"
            name="field"
            aria-label="Search field"
          >
            <option value="all">All fields</option>
            <option value="name">Author</option>
            <option value="id">Student ID</option>
            <option value="title">Title</option>
            <option value="content">Content</option>
            <option value="category">Category</option>
            <option value="tags">Tags</option>
          </select>
          <button class="search-submit" type="submit">Search</button>
        </form>

        <form
          class="articlebox"
          id="create-blog-form"
          action="/api/blogs"
          method="post"
          novalidate
        >
          <h1>Share a blog post</h1>

          <label for="blog-title">Title</label>
          <input
            class="article-input"
            id="blog-title"
            name="title"
            type="text"
            placeholder="Enter a descriptive title"
            minlength="5"
            maxlength="120"
            aria-describedby="blog-title-error"
            required
          />
          <small class="field-error" id="blog-title-error" aria-live="polite"></small>

          <label for="blog-category">Category</label>
          <select
            class="article-input"
            id="blog-category"
            name="category"
            aria-describedby="blog-category-error"
            required
          >
            <option value="">Choose a category</option>
            <option value="Academic">Academic</option>
            <option value="Events">Events</option>
            <option value="Student Life">Student Life</option>
            <option value="Technology">Technology</option>
            <option value="Other">Other</option>
          </select>
          <small class="field-error" id="blog-category-error" aria-live="polite"></small>

          <label for="blog-tags">Tags</label>
          <input
            class="article-input"
            id="blog-tags"
            name="tags"
            type="text"
            placeholder="For example: technology, study tips"
            aria-describedby="blog-tags-help blog-tags-error"
          />
          <small class="field-help" id="blog-tags-help">Enter 1–5 comma-separated tags.</small>
          <small class="field-error" id="blog-tags-error" aria-live="polite"></small>

          <label for="blog-content">Content</label>
          <textarea
            id="blog-content"
            name="content"
            placeholder="Write your blog post..."
            minlength="20"
            maxlength="5000"
            aria-describedby="blog-content-error"
            required
          ></textarea>
          <small class="field-error" id="blog-content-error" aria-live="polite"></small>

          <div class="articlefooter">
            <div>
              <input
                type="file"
                id="imageUpload"
                name="image"
                accept="image/png,image/jpeg,image/gif,image/webp"
                class="text-label"
                aria-describedby="blog-image-help blog-image-error"
              />
              <label for="imageUpload" class="upload-btn">Upload image</label>
              <small class="field-help" id="blog-image-help">Optional: PNG, JPEG, GIF, or WebP up to 4 MB.</small>
            </div>
            <div class="form-actions">
              <button class="btn cancel-edit" id="cancel-edit" type="button" hidden>Cancel edit</button>
              <button class="articlebtn" type="submit">Post</button>
            </div>
          </div>
          <small class="field-error" id="blog-image-error" aria-live="polite"></small>
          <p class="form-status" id="blog-form-status" aria-live="polite"></p>
        </form>

        <section class="contentbox" aria-labelledby="recent-blogs-title">
          <div class="content">
            <div class="main-content">
              <div class="list-heading">
                <h2 class="recent-article-title" id="recent-blogs-title">Recent blogs</h2>
                <div>
                  <label for="blog-sort">Sort by</label>
                  <select id="blog-sort" class="article-input">
                    <option value="newest">Newest first</option>
                    <option value="oldest">Oldest first</option>
                    <option value="title-az">Title A–Z</option>
                    <option value="title-za">Title Z–A</option>
                  </select>
                </div>
              </div>

              <p class="list-status" id="blog-list-status" aria-live="polite">Loading blogs...</p>
              <div id="blog-list"></div>
            </div>
          </div>
        </section>
      </section>

      <aside class="rightbar" aria-label="Blog help">
        <section class="itembar">
          <h2 class="itemtitle">Explore</h2>
          <ul class="quick-links">
            <li><a href="/discussions">Join a discussion</a></li>
            <li><a href="/reviews/browse">Browse reviews</a></li>
            <li><a href="/wishlist/add">Browse items</a></li>
          </ul>
        </section>

        <section class="itembar">
          <h2 class="itemtitle">Writing tips</h2>
          <p class="tip-text">Use a clear title, choose the closest category, and add useful tags so other students can find your post.</p>
        </section>
      </aside>
    </main>

    <script src="/js/blog.js" defer></script>
  </body>
</html>
