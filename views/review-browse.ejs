<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link href="/css/review.css" rel="stylesheet" />
  </head>

  <body>
    <header>
      <div class="logo">RMIT CONNECT</div>
      <input
        class="searchBar"
        type="text"
        placeholder="Search RMIT Connect..."
      />
      <nav>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/discussions">Discussions</a></li>
          <li><a href="/blogs">My Blog</a></li>
          <li><a href="/editprofile.html">My Profile</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <div class="pageBanner">
        <div class="pageBannerInner">
          <div class="pageBannerText">
            <h1 class="pageTitle">Browse Reviews</h1>
          </div>
          <div class="pageBannerButtonCell">
            <a class="newReviewBtn" href="/reviews">+ New Review</a>
          </div>
        </div>
      </div>

      <section class="section">
        <div class="sectionCard">
          <form class="filterBar" action="/reviews/search" method="get">
            <div class="filterBarCell">
              <label class="visuallyHiddenLabel" for="browseSearch"
                >Search reviews</label
              >
              <input
                class="filterInput"
                id="browseSearch"
                name="query"
                type="text"
                placeholder="Search by title, description, or reviewer..."
              />
            </div>
            <div class="filterBarCell">
              <label class="visuallyHiddenLabel" for="browseRating"
                >Filter by rating</label
              >
              <select class="filterSelect" id="browseRating" name="rating">
                <option value="0">Any rating</option>
                <option value="5">5 stars</option>
                <option value="4">4+ stars</option>
                <option value="3">3+ stars</option>
              </select>
            </div>
            <div class="filterBarCell">
              <label class="visuallyHiddenLabel" for="browseSort"
                >Sort by date</label
              >
              <select class="filterSelect" id="browseSort" name="sort">
                <option value="">Sort by date</option>
                <option value="newest">Newest first</option>
                <option value="oldest">Oldest first</option>
              </select>
            </div>
            <div class="filterBarCell">
              <button class="filterButton" type="submit">Search</button>
            </div>
          </form>
        </div>
      </section>

      <section class="section">
        <div class="sectionCard">
          <h2 class="sectionLabel">All Reviews</h2>
          <p class="listCount" id="listCount">Loading reviews...</p>

          <ul class="reviewList" id="reviewListContainer"></ul>
        </div>
      </section>
    </main>
    <script src="/js/review.js"></script>
  </body>
</html>
