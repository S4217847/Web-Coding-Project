<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Password Reset | RMIT Connect</title>
    <link rel="stylesheet" href="/css/common.css" />
    <link rel="stylesheet" href="/css/password.css" />
  </head>

  <body>
    <header>
      <div class="logo">RMIT CONNECT</div>
      <input
        class="searchbar"
        type="text"
        placeholder="Search RMIT Connect..."
      />

      <nav>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/discussions">Discussions</a></li>
          <li><a href="/blogs">My Blog</a></li>
          <li><a href="/editprofile.html">My Profile</a></li>
        </ul>
      </nav>
    </header>

    <main class="forgot-password-page">
      <div class="forgot-password-card">
        <% if (resetComplete) { %>
          <h1>Password Reset Complete</h1>

          <p class="forgot-password-text">
            Your password has been updated. You can now log in with your new
            password.
          </p>

          <p class="account-help">
            <a href="/login.html" class="common-link">Log in</a>
          </p>
        <% } else { %>
          <h1>Reset Password</h1>

          <p class="forgot-password-text">
            Enter and confirm a new password for your account.
          </p>

          <form
            id="reset-password-form"
            class="forgot-password-form"
            action="/reset-password"
            method="post"
          >
            <label for="new-password">New Password</label>
            <input
              id="new-password"
              type="password"
              name="new-password"
              minlength="8"
              maxlength="128"
              required
            />
            <div class="error" id="new-password-error-text">
              <%= newPasswordError %>
            </div>

            <label for="confirm-password">Confirm New Password</label>
            <input
              id="confirm-password"
              type="password"
              name="confirm-password"
              minlength="8"
              maxlength="128"
              required
            />
            <div class="error" id="confirm-password-error-text">
              <%= confirmPasswordError %>
            </div>

            <button class="resetbutton" type="submit">Reset Password</button>
          </form>

          <p class="reset-message">
            Use 8 to 128 characters with uppercase and lowercase letters and a
            number.
          </p>
        <% } %>
      </div>
    </main>

    <% if (!resetComplete) { %>
      <script src="/js/resetpassword.js"></script>
    <% } %>
  </body>
</html>
